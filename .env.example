# HuggingFace Inference API - DeepSeek Coder Model
HF_TOKEN=your_huggingface_token_here

# Primary Model: DeepSeek-Coder-V2-Lite-Instruct (RECOMMENDED)
# - Advanced code understanding and generation
# - Large context window (128K tokens)
# - Better performance on complex tasks
HF_MODEL=deepseek-ai/DeepSeek-Coder-V2-Lite-Instruct
HF_PROVIDER=auto

# Alternative Models (comment/uncomment as needed)
# HF_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct        # Balanced performance
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct      # General purpose
# HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2    # Fast inference

# Model Parameters
MAX_TOKENS=4096
TEMPERATURE=0.7
TOP_P=0.95
TOP_K=40

# Puter.js Configuration (current implementation)
PUTER_API_KEY=your_puter_api_key_here

# API Configuration
API_BASE_URL=https://api-inference.huggingface.co/models/
API_TIMEOUT=60000
ENABLE_STREAMING=true
RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# App Configuration
CREDIT_SYSTEM_ENABLED=true
INITIAL_CREDITS=1000
CREDIT_PER_REQUEST=10

# Provider Selection Strategy
# auto - First available provider
# fastest - Highest throughput (tokens/sec)
# cheapest - Lowest cost per output token
PROVIDER_SELECTION=auto

# Development
DEBUG_MODE=false
ENV=development
LOG_LEVEL=info
