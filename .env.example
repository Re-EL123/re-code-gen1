# HuggingFace Inference API
HF_TOKEN=your_huggingface_token_here
HF_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
HF_PROVIDER=auto

# Alternative Models (comment/uncomment as needed)
# HF_MODEL=deepseek-ai/DeepSeek-Coder-V2-Lite-Instruct
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Puter.js Configuration (current implementation)
PUTER_API_KEY=your_puter_api_key_here

# API Configuration
API_BASE_URL=https://api-inference.huggingface.co/models/
API_TIMEOUT=30000
ENABLE_STREAMING=true

# App Configuration
CREDIT_SYSTEM_ENABLED=true
INITIAL_CREDITS=1000
CREDIT_PER_REQUEST=10

# Development
DEBUG_MODE=false
ENV=development
